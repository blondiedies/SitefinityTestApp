@model SitefinityWebApp.Mvc.ViewModels.MarqueeSliderViewModel

<h5> Ejemplo de Marquee</h5>

<div class="marquee-container overflow-hidden bg-light shadow-sm">
    <div class="marquee-content d-flex align-items-center">
        <div class="marquee-item px-4  bg-primary text-white rounded-pill mx-2">
            <span class="B">B</span><span class="N">N</span><span class="C">C</span>, soluciones financieras justo a tu medida.
        </div>
        <div class="marquee-item px-4  bg-success text-white rounded-pill mx-2">
            Utiliza plataformas electrónicas seguras y autorizadas.
        </div>
        <div class="marquee-item px-4  bg-info text-white rounded-pill mx-2">
            <span class="fw-semibold">Menudeo</span> <i class="bi bi-caret-right-fill"></i> Fecha valor: <span class="CURRENCY ItemSpace">@Model.MenudeoFecha</span><span class="USD"> USD $ </span>Compra Bs: @Model.MenudeoCompra / Venta Bs: @Model.MenudeoVenta
        </div>
        <div class="marquee-item px-4  bg-warning text-white rounded-pill mx-2">
            <span class="fw-semibold">Mesa de cambio</span> <i class="bi bi-caret-right-fill"></i> Fecha valor: <span class="CURRENCY ItemSpace">@Model.MesaCambioFecha</span> <span class="USD"> USD $ </span>TC Compra: @Model.MesaCambioCompra / TC Venta: @Model.MesaCambioVenta
        </div>
        <div class="marquee-item px-4 bg-danger text-white rounded-pill mx-2">
            <span class="fw-semibold">Cotización del Petro</span> <i class="bi bi-caret-right-fill"></i> 1 Petro / @Model.PetroCotizacion
        </div>
    </div>
</div>

<script>
    const marquee = document.querySelector('.marquee-content');
    const container = document.querySelector('.marquee-container');

    const distance = marquee.scrollWidth;
    marquee.style.setProperty('--marquee-distance', `${distance}px`);
</script>
