@model SitefinityWebApp.Mvc.ViewModels.BNC.BNCNavBarViewModel
@using SitefinityWebApp.Mvc.ViewModels.BNC

@{
    var idKey = (Model.Key ?? Model.Title ?? "menu").Replace(" ", "");
    var collapseId = idKey + "Collapse";
}

<div class="collapse collapse-bnc-fade"
     id="@collapseId"
     data-bs-parent="#bncNavbarAccordion">

    <div class="p-4 border-bottom shadow-sm collapse-bnc">
        <div class="container collapse-bnc-inner">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 fw-bold">@Model.Title</h5>
            </div>

            <ul class="list-unstyled row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                @foreach (var item in Model.Listado ?? Enumerable.Empty<NavBarMenuViewModel>())
                {
                    <li>
                        <a class="text-decoration-none d-block p-2 rounded bnc-menu-item-hover" href="@item.Url" target="@item.Target">
                            <div class="fw-semibold text-dark">@item.LinkTitle</div>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div class="small text-muted">@item.Description</div>
                            }
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>