@model SitefinityWebApp.Mvc.ViewModels.BNC.BNCNavBarViewModel
    @using SitefinityWebApp.Mvc.ViewModels.BNC
@{
    var idKey = (Model.Key ?? Model.Title ?? "menu").Replace(" ", "");
    var offcanvasId = idKey + "Offcanvas";
    var offcanvasLabel = idKey + "OffcanvasLabel";
}
<div class="offcanvas offcanvas-top offcanvas-bnc" tabindex="-1" id="@offcanvasId" aria-labelledby="@offcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="@offcanvasLabel">@Model.Title</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <ul class="list-unstyled mb-0">
            @foreach (var item in Model.Listado ?? Enumerable.Empty<NavBarMenuViewModel>())
            {
                <li class="py-2">
                    <a class="d-flex align-items-start gap-2" href="@item.Url" target="@item.Target">
                        @if (!string.IsNullOrEmpty(item.IconClass))
                        {
                            <i class="@item.IconClass me-2" aria-hidden="true"></i>
                        }
                        <div>
                            <div class="fw-semibold">@item.LinkTitle</div>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <small class="text-muted">@item.Description</small>
                            }
                        </div>
                    </a>
                </li>
            }
        </ul>
    </div>
</div>