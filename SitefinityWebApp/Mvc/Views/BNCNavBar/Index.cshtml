@model SitefinityWebApp.Mvc.Models.BNC.NavBar.BNCNavBarModel
@using SitefinityWebApp.Mvc.ViewModels.BNC
@using SitefinityWebApp.Custom.Utilities;
@using System.Text.RegularExpressions


<header class="header">
    @if (Model.MenuList == null || !Model.MenuList.Any())
    {
<div class="bnc-navbar-placeholder">Menú no disponible</div>
}
else { 
    <nav class="navbar navbar-expand-lg">
        <div class="container navbar-container">
            <a class="navbar-brand" href="https://www.bncenlinea.com/">
                <img alt="" title="" src="~/AdminApp/assets/images/BNC/Banco_Nacional_de_Credito.png" class="bnc-navbar-logo" />
            </a>

            <div class="d-lg-flex gap-5">
                @foreach (var section in Model.MenuList ?? Enumerable.Empty<BNCNavBarViewModel>())
                {
                    var title = section.Title;
                    var idKey = BNCUtils.SanitizeURLKey(section.Key ?? section.Title ?? "menu");
                    <a class="nav-link header-link" role="button" data-bs-toggle="offcanvas" href="#@(idKey)Offcanvas" aria-controls="@(idKey)Offcanvas">
                        @title <i class="header-chevron bi bi-chevron-down"></i>
                    </a>
                }
            </div>

            <div class="d-flex navbar-button-segment-right">
                <div class="ms-auto d-flex gap-3">
                    <a class="btn btn-orange btn-link" href="/preregistro-bnc">Hazte Cliente</a>
                    <a class="btn btn-white-orange btn-link" href="/bnc-en-linea">Entrar <i class="header-chevron bi bi-chevron-down"></i></a>
                </div>
            </div>
        </div>
    </nav>
    }
</header>

@* Render offcanvas partials for every section *@
@foreach (var section in Model.MenuList ?? Enumerable.Empty<BNCNavBarViewModel>())
{
    @Html.Partial("_NavBarOffcanvasMenu", section)
}